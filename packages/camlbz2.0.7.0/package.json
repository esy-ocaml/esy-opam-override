{
  "buildEnv": {
    "CFLAGS": "-I#{esy-bzip2.install / 'include' $CFLAGS}",
    "LDFLAGS": "-L#{esy-bzip2.lib $LDFLAGS}"
  },
  "build": [
    "aclocal -I .",
    "autoconf",
    "bash -c \"#{os == 'windows' ? 'patch -p1 < dll_windows.patch' : 'true'}\"",
    "./configure CFLAGS=$CFLAGS LDFLAGS=$LDFLAGS --prefix=#{self.install}",
    "make CFLAGS=$CFLAGS LDFLAGS=$LDFLAGS CLIBS=$LDFLAGS"
  ],
  "install": [
    ["make", "SO=#{os == 'windows' ? 'dll' : 'so'}", "CLIBS=$LDFLAGS", "install"]
  ],
  "dependencies": {
    "esy-bzip2": "*"
  }
}
